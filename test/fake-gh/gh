#!/bin/bash
# The fake `gh` for tests (gh.mjs). A Node process per call costs ~45 ms of
# CPU, most of it Node starting, so this shim forwards the call (argv, cwd,
# environment, and stdin for `--input -`) to the fake gh server of the test
# process at $CRB_FAKE_GH_SERVER (server.mjs) and gives back its stdout,
# stderr and exit code. Without a server it runs the call in a Node process
# of its own (cli.mjs). Killing the shim ends the call (an unheld write
# that already saved stays saved, as with a killed process).
if [[ $CRB_FAKE_GH_SERVER =~ ^127\.0\.0\.1:([0-9]+)$ ]] &&
	{ exec 3<>"/dev/tcp/127.0.0.1/${BASH_REMATCH[1]}"; } 2>/dev/null; then
	input=0
	prev=
	for a in "$@"; do
		[[ $prev == --input && $a == - ]] && input=1
		prev=$a
	done
	{
		printf '%s\0' "$$" "$PWD" "$input" "$#" "$@"
		for n in $(compgen -e); do printf '%s=%s\0' "$n" "${!n}"; done
		printf '\0'
		if ((input)); then
			IFS= read -r -d '' body
			printf '%s\0' "$body"
		fi
	} >&3
	# Byte counts: read -N counts characters, bytes in the C locale.
	LC_ALL=C
	if ! read -r code errn outn <&3; then
		echo "fake gh: its server closed the call" >&2
		exit 1
	fi
	IFS= read -r -N "$errn" e <&3
	IFS= read -r -N "$outn" o <&3
	printf '%s' "$o"
	printf '%s' "$e" >&2
	exit "$code"
fi
exec node "${0%/*}/cli.mjs" "$@"
