#!/usr/bin/env node
// A fake `gh` for tests. It answers exactly the calls src/server/gh.ts and
// src/server/clone.ts make, from the scenario JSON at $CRB_FAKE_GH (see
// scenario.ts). Every call is appended to $CRB_FAKE_GH_LOG when set.
import { execFileSync } from "node:child_process";
import { appendFileSync, readFileSync, writeFileSync } from "node:fs";

const args = process.argv.slice(2);
const s = JSON.parse(readFileSync(process.env.CRB_FAKE_GH, "utf8"));
// Logged after reading the scenario: once a call shows in the log, a test may
// rewrite the scenario without affecting that call.
if (process.env.CRB_FAKE_GH_LOG) {
	appendFileSync(process.env.CRB_FAKE_GH_LOG, `${args.join(" ")}\n`);
}

function fail(message, code = 1) {
	process.stderr.write(`${message}\n`);
	process.exit(code);
}
function print(value) {
	process.stdout.write(`${JSON.stringify(value)}\n`);
	process.exit(0);
}
const unsupported = () => fail(`fake gh: unsupported: ${args.join(" ")}`, 2);
const sleep = (ms) =>
	Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);
/** Writes the scenario back: writes (replies, resolving) last for the test. */
const save = () =>
	writeFileSync(process.env.CRB_FAKE_GH, JSON.stringify(s, null, "\t"));
/** The scenario's failNext when it is for `op`, used up. */
function failNextFor(op) {
	const f = s.failNext;
	if (!f || f.op !== op) return undefined;
	delete s.failNext;
	save();
	return f;
}
/**
 * A thread as GitHub's GraphQL lists it now: without replies still within
 * their `hiddenUntil` (replyUnlistedMs), which come last.
 */
function unlisted(t) {
	const all = t.comments?.nodes ?? [];
	const shown = all.filter((c) => !(c.hiddenUntil > Date.now()));
	if (shown.length === all.length) return t;
	const last = shown.at(-1);
	return {
		...t,
		comments: {
			...t.comments,
			totalCount: t.comments.totalCount - (all.length - shown.length),
			nodes: shown,
		},
		latest: last
			? {
					nodes: [
						{
							author: last.author,
							createdAt: last.createdAt,
							publishedAt: last.publishedAt,
							state: last.state,
						},
					],
				}
			: t.latest,
	};
}
/** The REST id of a thread's comment: (index + 1) * 1000 + its position. */
const restId = (i, j) => (i + 1) * 1000 + j;
/**
 * A PR's thread nodes, each with an id (`T<pr>-<index>` unless it has
 * one), what the viewer may do (GitHub's defaults: reply, and resolve an
 * open thread or unresolve a resolved one) and its comments' REST ids.
 */
const threadNodes = (pr, nodes) =>
	nodes.map(unlisted).map((t, i) => {
		// Comment ids: `C<pr>-<index>` for the opener, `-<n>` after for the rest.
		const cid = (c, j) => c?.id ?? (j === 0 ? `C${pr}-${i}` : `C${pr}-${i}-${j}`);
		const ided = (c, j) => ({ ...c, id: cid(c, j), databaseId: restId(i, j) });
		return {
			viewerCanReply: true,
			viewerCanResolve: !t.isResolved,
			viewerCanUnresolve: t.isResolved === true,
			...t,
			id: t.id ?? `T${pr}-${i}`,
			...(t.first
				? {
						first: {
							...t.first,
							nodes: (t.first.nodes ?? []).map(ided),
						},
					}
				: {}),
			...(t.comments
				? {
						comments: {
							...t.comments,
							nodes: (t.comments.nodes ?? []).map(ided),
						},
					}
				: {}),
		};
	});
/**
 * Where thread `id` is: its PR's number, its index there and the node as
 * served; none once deleted (deletedThreads).
 */
function threadPlace(id) {
	if ((s.deletedThreads ?? []).includes(id)) return undefined;
	for (const [n, p] of Object.entries(s.prs)) {
		const nodes = threadNodes(n, p.graphql?.reviewThreads ?? []);
		const i = nodes.findIndex((t) => t.id === id);
		if (i >= 0) return { n, i, node: nodes[i] };
	}
	return undefined;
}
/** A thread node by its id, in any PR; none once deleted (deletedThreads). */
const threadById = (id) => threadPlace(id)?.node;
/** A thread node as a summary query gets it: no text, a page of comments. */
const summarize = (t) => ({
	...t,
	first: { nodes: (t.first?.nodes ?? []).map(summaryOf) },
	...(t.comments
		? {
				comments: {
					totalCount: t.comments.totalCount,
					...commentPage((t.comments.nodes ?? []).map(summaryOf), 0),
				},
			}
		: {}),
});
const escapeHtml = (t) =>
	t.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
/**
 * Appends the viewer's reply to the thread at index `i` of PR `n` (in the
 * scenario, saved) and returns it as GitHub's REST API answers.
 */
function storeReply(n, i, body) {
	const t = s.prs[n].graphql.reviewThreads[i];
	const now = new Date().toISOString().replace(/\.\d+Z$/, "Z");
	const author = { login: s.user.login, __typename: "User" };
	const times = { createdAt: now, publishedAt: now, state: "SUBMITTED" };
	const listed = t.comments?.nodes ?? [];
	// Older fixtures keep the opener only in `first`.
	const before = listed.length ? listed : (t.first?.nodes ?? []).slice(0, 1);
	const html = `<p dir="auto">${escapeHtml(body)}</p>`;
	t.comments = {
		...(t.comments ?? {}),
		totalCount: (t.comments?.totalCount ?? before.length) + 1,
		nodes: [
			...before,
			{
				author,
				...times,
				body,
				bodyText: body,
				bodyHTML: html,
				...(s.replyUnlistedMs ? { hiddenUntil: Date.now() + s.replyUnlistedMs } : {}),
			},
		],
	};
	t.latest = { nodes: [{ author, ...times }] };
	save();
	const j = t.comments.nodes.length - 1;
	return {
		id: restId(i, j),
		node_id: t.comments.nodes[j].id ?? `C${n}-${i}-${j}`,
		in_reply_to_id: restId(i, 0),
		body,
		body_text: body,
		body_html: html,
		user: { login: s.user.login },
		created_at: now,
	};
}
/**
 * Fails like `gh api` on an HTTP error: GitHub's answer on stdout, and on
 * stderr only its top-level message with the status (the details stay in
 * the answer).
 */
function httpFail(status, message, errors) {
	process.stdout.write(
		`${JSON.stringify({ message, ...(errors ? { errors } : {}), status: String(status) })}\n`,
	);
	fail(`gh: ${message} (HTTP ${status})`);
}
/**
 * Fails like `gh api graphql` on GraphQL errors: the answer (data null)
 * on stdout, `gh: <messages>` on stderr; an error's `type` only if given.
 */
function graphqlFail(field, errors) {
	process.stdout.write(
		`${JSON.stringify({ data: { [field]: null }, errors: errors.map((e) => ({ ...e, path: [field] })) })}\n`,
	);
	fail(`gh: ${errors.map((e) => e.message).join("\n")}`);
}
/** The scenario's failNext, as gh would fail with it. */
function failAs(f, field) {
	if (f.graphql) graphqlFail(field, [f.graphql]);
	httpFail(f.status, f.message ?? HTTP_MESSAGES[f.status] ?? "Error");
}
const HTTP_MESSAGES = {
	400: "Problems parsing JSON",
	401: "Bad credentials",
	403: "Resource not accessible by integration",
	410: "Gone",
	404: "Not Found",
	422: "Unprocessable Entity",
	500: "Server Error",
	502: "Bad Gateway",
	503: "Service Unavailable",
};
/** A comment without its text, as a summary lists it. */
const summaryOf = ({ body, bodyText, bodyHTML, diffHunk, ...rest }) => rest;
/**
 * Every comment of a thread node with its text: the listed ones, the
 * opener's text and hunk from `first` (older fixtures keep it only there).
 */
function commentTexts(node) {
	const listed = node.comments?.nodes ?? [];
	const opener = node.first?.nodes?.[0] ?? {};
	return (listed.length ? listed : [opener]).map((c, j) => {
		const own = j === 0 ? { ...c, ...opener, id: c.id ?? opener.id } : c;
		return {
			...own,
			body: own.body ?? own.bodyText ?? "",
			bodyText: own.bodyText ?? "",
			bodyHTML: own.bodyHTML ?? "",
			diffHunk: j === 0 ? (opener.diffHunk ?? "") : (own.diffHunk ?? ""),
		};
	});
}
/** A page of a thread's comments from `start` (cursor `cursor:<n>`). */
function commentPage(all, start) {
	const end = start + (s.commentPageSize ?? 100);
	const hasNextPage = end < all.length;
	return {
		pageInfo: { hasNextPage, endCursor: hasNextPage ? `cursor:${end}` : null },
		nodes: all.slice(start, end),
	};
}
const notFound = (n) =>
	fail(
		`GraphQL: Could not resolve to a PullRequest with the number of ${n}. (repository.pullRequest)`,
	);

/** Values of `-f key=value` / `-F key=value` pairs. */
function fields() {
	const out = {};
	for (let i = 0; i < args.length - 1; i++) {
		if (args[i] !== "-f" && args[i] !== "-F") continue;
		const [key, ...rest] = args[i + 1].split("=");
		out[key] = rest.join("=");
	}
	return out;
}

/**
 * A PR's review comments as GitHub's REST API lists them, one per comment of
 * its thread nodes (opener first, replies with `in_reply_to_id`), each
 * merged with `restEdits[<comment node id>]`.
 */
function restComments(n, pr) {
	const out = [];
	threadNodes(n, pr.graphql?.reviewThreads ?? []).forEach((t, i) => {
		const opener = t.first?.nodes?.[0] ?? t.comments?.nodes?.[0];
		if (!opener) return;
		const file = t.subjectType === "FILE";
		const anchor = {
			path: t.path,
			subject_type: file ? "file" : "line",
			line: t.line ?? null,
			original_line: t.originalLine ?? null,
			start_line: t.startLine ?? null,
			original_start_line: t.originalStartLine ?? null,
			side: file ? null : (t.diffSide ?? "RIGHT"),
			start_side: t.startDiffSide ?? null,
			original_commit_id: opener.originalCommit?.oid ?? null,
		};
		const replies = (t.comments?.nodes ?? []).slice(1);
		const openerId = (i + 1) * 1000;
		[opener, ...replies].forEach((c, j) => {
			out.push({
				id: openerId + j,
				node_id: c.id,
				...anchor,
				diff_hunk: opener.diffHunk ?? "",
				created_at: c.createdAt,
				...(j ? { in_reply_to_id: openerId } : {}),
				...(s.restEdits?.[c.id] ?? {}),
			});
		});
	});
	return out;
}

// REST reply: `api -X POST repos/<o>/<r>/pulls/<n>/comments/<id>/replies
// -H "Accept: …" -f body=…`, to the opening comment's REST id.
const restReply =
	args[0] === "api" && args[1] === "-X" && args[2] === "POST"
		? /^repos\/[^/]+\/[^/]+\/pulls\/(\d+)\/comments\/(\d+)\/replies$/.exec(args[3] ?? "")
		: null;
if (args[0] === "api" && args[1] === "-X" && !restReply) unsupported();
if (restReply && !s.loggedOut) {
	const [, n, id] = restReply;
	if (args.slice(4).join(" ") !== "-H Accept: application/vnd.github.full+json --input -") {
		unsupported();
	}
	const { body } = JSON.parse(readFileSync(0, "utf8"));
	const pr = s.prs[n];
	if (!pr) httpFail(404, "Not Found");
	const nodes = threadNodes(n, pr.graphql?.reviewThreads ?? []);
	const i = nodes.findIndex((_, k) => restId(k, 0) === Number(id));
	if (i < 0 || (s.deletedThreads ?? []).includes(nodes[i].id)) {
		httpFail(404, "Not Found");
	}
	const f = failNextFor("reply");
	if (f && !f.afterWrite) failAs(f);
	if (s.replyDelayMs) sleep(s.replyDelayMs);
	const pending = (pr.graphql?.reviews ?? []).some(
		(r) =>
			r.state === "PENDING" &&
			r.author?.login?.toLowerCase() === s.user.login.toLowerCase(),
	);
	if (pending) {
		httpFail(422, "Unprocessable Entity", [
			"user_id can only have one pending review per pull request",
		]);
	}
	if (nodes[i].viewerCanReply === false) httpFail(403, HTTP_MESSAGES[403]);
	if (!body?.trim()) httpFail(422, "Validation Failed", ["Body can't be blank"]);
	const posted = storeReply(n, i, body);
	if (s.replyDeletesThread) {
		s.deletedThreads = [...(s.deletedThreads ?? []), nodes[i].id];
		save();
	}
	if (f) failAs(f);
	print(posted);
}

// REST: `api repos/<owner>/<repo>/pulls/<n>/comments --paginate --slurp`,
// every page in one array.
const restPull = /^repos\/[^/]+\/[^/]+\/pulls\/(\d+)\/comments$/.exec(
	args[1] ?? "",
);
if (restPull && args[0] === "api" && !s.loggedOut) {
	if (args.slice(2).join(" ") !== "--paginate --slurp") unsupported();
	const pr = s.prs[restPull[1]];
	if (!pr) fail("gh: Not Found (HTTP 404)");
	const all = restComments(restPull[1], pr);
	const size = s.pageSize ?? 30;
	const pages = [];
	for (let i = 0; i < all.length; i += size) pages.push(all.slice(i, i + size));
	print(pages);
}

const cmd = `${args[0]} ${args[1]}`;
const known = [
	"auth status",
	"api user",
	"api graphql",
	"repo view",
	"repo clone",
	"pr view",
];
if (!known.includes(cmd) && !restPull && !restReply) unsupported();

if (s.loggedOut) {
	if (cmd === "auth status") {
		fail(
			"You are not logged into any GitHub hosts. To log in, run: gh auth login",
		);
	}
	fail("To get started with GitHub CLI, please run:  gh auth login", 4);
}

switch (cmd) {
	case "auth status":
		process.stdout.write(
			`github.com\n  ✓ Logged in to github.com account ${s.user.login}\n`,
		);
		process.exit(0);
		break;
	case "api user":
		if (args.length !== 2) unsupported();
		print(s.user);
		break;
	case "repo view":
		if (args.slice(2).join(" ") !== "--json nameWithOwner") unsupported();
		if (!s.nameWithOwner) {
			fail(
				"none of the git remotes configured for this repository point to a known GitHub host",
			);
		}
		print({ nameWithOwner: s.nameWithOwner });
		break;
	case "repo clone": {
		const [, , , path, ...flags] = args;
		if (flags.join(" ") !== "-- --bare --quiet") unsupported();
		// Like a real clone failing: git's progress line, then its fatal line.
		if (s.cloneError) {
			fail(`Cloning into bare repository '${path}'...\n${s.cloneError}`, 128);
		}
		try {
			execFileSync("git", ["clone", "--quiet", "--bare", s.repoPath, path], {
				stdio: ["ignore", "ignore", "pipe"],
			});
		} catch (error) {
			fail(String(error.stderr).trim() || "git clone failed");
		}
		process.exit(0);
		break;
	}
	case "pr view": {
		const [, , n, r, , json, wanted, ...extra] = args;
		if (r !== "-R" || json !== "--json" || !wanted || extra.length) {
			unsupported();
		}
		const pr = s.prs[n];
		if (!pr) notFound(n);
		if (s.prViewDelayMs) {
			Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, s.prViewDelayMs);
		}
		const out = {};
		for (const f of wanted.split(",")) if (f in pr.view) out[f] = pr.view[f];
		print(out);
		break;
	}
	case "api graphql": {
		const f = fields();
		const pr0 = () => s.prs[f.number];
		if (s.failGraphql && f.query?.includes(s.failGraphql)) {
			fail("GraphQL: Something went wrong while executing your query.");
		}
		// Resolving: mutation($id: ID!) { (un)resolveReviewThread(input: …) }.
		const mutation = /^mutation\(\$id: ID!\) \{ (resolveReviewThread|unresolveReviewThread)\(/.exec(
			f.query ?? "",
		)?.[1];
		if (mutation) {
			const gqlFail = (type, message) => graphqlFail(mutation, [{ type, message }]);
			const place = threadPlace(f.id);
			if (!place) {
				gqlFail("NOT_FOUND", `Could not resolve to a node with the global id of '${f.id}'`);
			}
			const resolve = mutation === "resolveReviewThread";
			const failing = failNextFor("resolve");
			const forbidden = `${s.user.login} does not have permission to ${resolve ? "resolve" : "unresolve"} this review thread.`;
			if (failing?.status === 403) gqlFail("FORBIDDEN", forbidden);
			if (failing && !failing.afterWrite) failAs(failing, mutation);
			const allowed = resolve
				? place.node.viewerCanResolve !== false || place.node.isResolved
				: place.node.viewerCanUnresolve !== false || !place.node.isResolved;
			if (!allowed) gqlFail("FORBIDDEN", forbidden);
			const t = s.prs[place.n].graphql.reviewThreads[place.i];
			t.isResolved = resolve;
			// GitHub's own: who can resolve can unresolve, and the other way.
			const can = t.viewerCanResolve !== false || t.viewerCanUnresolve !== false;
			if (can) {
				t.viewerCanResolve = !resolve;
				t.viewerCanUnresolve = resolve;
			}
			save();
			if (failing) failAs(failing, mutation);
			print({ data: { [mutation]: { thread: { id: f.id, isResolved: resolve } } } });
		}
		// One thread's summary by id, and its PR (a write's re-read).
		if (/node\(id: \$id\) \{\s*\.\.\. on PullRequestReviewThread \{/.test(f.query)) {
			const place = threadPlace(f.id);
			if (!place) {
				process.stdout.write(
					`${JSON.stringify({ data: { node: null }, errors: [{ type: "NOT_FOUND", path: ["node"], message: `Could not resolve to a node with the global id of '${f.id}'` }] })}\n`,
				);
				fail(`gh: Could not resolve to a node with the global id of '${f.id}'`);
			}
			print({
				data: {
					node: {
						...summarize(place.node),
						pullRequest: {
							number: Number(place.n),
							repository: { nameWithOwner: s.nameWithOwner ?? "acme/widget" },
						},
					},
				},
			});
		}
		// The rest of one review's comments (--head reviewed): node(id) {
		// ... on PullRequestReview { comments(first: 100, after: $endCursor) } },
		// from reviewComments (the whole list; the review node holds page 1).
		if (/node\(id: \$id\) \{\s*\.\.\. on PullRequestReview \{/.test(f.query)) {
			const all = s.reviewComments?.[f.id];
			if (!all) {
				print({
					data: { node: null },
					errors: [{ type: "NOT_FOUND", path: ["node"] }],
				});
			}
			const size = s.pageSize ?? 100;
			const start = f.endCursor ? Number(f.endCursor.replace("cursor:", "")) : 0;
			const end = start + size;
			const hasNextPage = end < all.length;
			print({
				data: {
					node: {
						comments: {
							pageInfo: {
								hasNextPage,
								endCursor: hasNextPage ? `cursor:${end}` : null,
							},
							nodes: all.slice(start, end),
						},
					},
				},
			});
		}
		// The rest of threads' comments, a page each by alias:
		// t<i>: node(id: "…") { … comments(first: 100, after: "cursor:<n>") }.
		const aliased = [
			...f.query.matchAll(
				/(t\d+): node\(id: "([^"]*)"\) \{ \.\.\. on PullRequestReviewThread \{ comments\(first: 100(?:, after: "([^"]*)")?\)/g,
			),
		];
		if (aliased.length) {
			if (s.commentsDelayMs) sleep(s.commentsDelayMs);
			const text = f.query.includes("bodyHTML");
			const data = {};
			const errors = [];
			for (const [, alias, id, after] of aliased) {
				const node = threadById(id);
				if (!node) {
					data[alias] = null;
					errors.push({
						type: "NOT_FOUND",
						path: [alias],
						message: `Could not resolve to a node with the global id of '${id}'`,
					});
					continue;
				}
				const all = commentTexts(node).map((c) => (text ? c : summaryOf(c)));
				const start = after ? Number(after.replace("cursor:", "")) : 0;
				data[alias] = { comments: commentPage(all, start) };
			}
			if (errors.length) {
				process.stdout.write(`${JSON.stringify({ data, errors })}\n`);
				fail(`gh: ${errors[0].message}`);
			}
			print({ data });
		}
		// Threads' comments by node id (any PR's threads), their text
		// included: the first page of each (commentPageSize).
		const byIds = /nodes\(ids: \[([^\]]*)\]\)/.exec(f.query);
		if (byIds) {
			if (s.threadContentDelayMs) sleep(s.threadContentDelayMs);
			if (s.commentsDelayMs) sleep(s.commentsDelayMs);
			const ids = [...byIds[1].matchAll(/"([^"]*)"/g)].map((m) => m[1]);
			const nodes = ids.map((id) => {
				const node = threadById(id);
				if (!node) return null;
				const all = commentTexts(node);
				return {
					id,
					comments: {
						totalCount: node.comments?.totalCount ?? all.length,
						...commentPage(all, 0),
					},
				};
			});
			const missing = ids.flatMap((id, i) => (nodes[i] ? [] : [[id, i]]));
			if (missing.length) {
				// Like GitHub: the data, an error per missing node, and gh exits 1.
				process.stdout.write(
					`${JSON.stringify({
						data: { nodes },
						errors: missing.map(([id, i]) => ({
							type: "NOT_FOUND",
							path: ["nodes", i],
							locations: [{ line: 1, column: 9 }],
							message: `Could not resolve to a node with the global id of '${id}'`,
						})),
					})}\n`,
				);
				fail(
					`gh: Could not resolve to a node with the global id of '${missing[0][0]}'`,
				);
			}
			print({ data: { nodes } });
		}
		// The timeline, a page by position (`skip`).
		if (/timelineItems\(first: \d+, skip: \$skip/.test(f.query)) {
			if (!pr0()) notFound(f.number);
			if (s.timelineDelayMs) sleep(s.timelineDelayMs);
			const all = pr0().graphql?.timelineItems ?? [];
			const size = Number(/timelineItems\(first: (\d+)/.exec(f.query)[1]);
			const skip = Number(f.skip ?? 0);
			// A test can make the list change between the pages' reads.
			// Counted but not listed (GitHub's caps, items the token can't see).
			const counted = all.length + (s.timelineUnlisted ?? 0);
			const count = s.timelineCountDrift ? counted + skip : counted;
			print({
				data: {
					repository: {
						pullRequest: {
							commits: {
								totalCount:
									pr0().graphql?.commitCount ??
									all.filter((n) => n.__typename === "PullRequestCommit").length,
							},
							timelineItems: {
								filteredCount: count,
								nodes: all.slice(skip, skip + size),
							},
						},
					},
				},
			});
		}
		const conn = /(\w+)\((?:first: \d+, after: \$endCursor|last: \d+)\)/.exec(
			f.query,
		)?.[1];
		// A connection's last page (`last: N`), not one after a cursor.
		const fromEnd = f.query.includes(`${conn}(last: `);
		const pr = s.prs[f.number];
		// The description query: pullRequest { bodyHTML }, no connection.
		if (!conn && /pullRequest\(number: \$number\) \{ bodyHTML \}/.test(f.query)) {
			if (!pr) notFound(f.number);
			print({
				data: {
					repository: { pullRequest: { bodyHTML: pr.graphql?.bodyHTML ?? "" } },
				},
			});
		}
		// One commit's checks: object(oid) { ... statusCheckRollup { contexts } }.
		if (conn === "contexts") {
			const commit = s.commits?.[f.oid];
			if (commit === undefined) {
				print({ data: { repository: { object: null } } });
			}
			if (commit.contexts === null) {
				print({ data: { repository: { object: { statusCheckRollup: null } } } });
			}
			const all = commit.contexts ?? [];
			const size = s.pageSize ?? 100;
			const start = f.endCursor ? Number(f.endCursor.replace("cursor:", "")) : 0;
			const end = start + size;
			const hasNextPage = end < all.length;
			print({
				data: {
					repository: {
						object: {
							statusCheckRollup: {
								contexts: {
									pageInfo: {
										hasNextPage,
										endCursor: hasNextPage ? `cursor:${end}` : null,
									},
									nodes: all.slice(start, end),
								},
							},
						},
					},
				},
			});
		}
		if (!["reviewThreads", "comments", "reviews", "commits"].includes(conn)) {
			unsupported();
		}
		if (!pr) notFound(f.number);
		let all = pr.graphql?.[conn] ?? [];
		if (conn === "reviewThreads") {
			if (s.threadsDelayMs) sleep(s.threadsDelayMs);
			all = threadNodes(f.number, all);
			// Only the fields asked for: a summary has no comment text, and
			// lists a thread's first page of comments (commentPageSize).
			if (!f.query.includes("bodyHTML")) all = all.map(summarize);
		}
		const size = s.pageSize ?? 100;
		const start = fromEnd
			? Math.max(0, all.length - size)
			: f.endCursor
				? Number(f.endCursor.replace("cursor:", ""))
				: 0;
		const end = start + size;
		const hasNextPage = !fromEnd && end < all.length;
		print({
			data: {
				repository: {
					pullRequest: {
						[conn]: {
							totalCount: all.length,
							pageInfo: {
								hasNextPage,
								endCursor: hasNextPage ? `cursor:${end}` : null,
							},
							nodes: all.slice(start, end),
						},
					},
				},
			},
		});
		break;
	}
}
