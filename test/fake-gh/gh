			print({ data });
		}
		// Resolving: mutation($id: ID!) { (un)resolveReviewThread(input: …) }.
		const mutation = /^mutation\(\$id: ID!\) \{ (resolveReviewThread|unresolveReviewThread)\(/.exec(
			f.query ?? "",
		)?.[1];
		if (mutation) {
			const gqlFail = (type, message) => graphqlFail(mutation, [{ type, message }]);
			const place = threadPlace(f.id);
			if (!place) {
				gqlFail("NOT_FOUND", `Could not resolve to a node with the global id of '${f.id}'`);
			}
			const resolve = mutation === "resolveReviewThread";
			const failing = failNextFor("resolve");
			const forbidden = `${s.user.login} does not have permission to ${resolve ? "resolve" : "unresolve"} this review thread.`;
			if (failing?.status === 403) gqlFail("FORBIDDEN", forbidden);
			if (failing && !failing.afterWrite) failAs(failing, mutation);
			const allowed = resolve
				? place.node.viewerCanResolve !== false || place.node.isResolved
				: place.node.viewerCanUnresolve !== false || !place.node.isResolved;
			if (!allowed) gqlFail("FORBIDDEN", forbidden);
			const t = s.prs[place.n].graphql.reviewThreads[place.i];
			t.isResolved = resolve;
			// GitHub's own: who can resolve can unresolve, and the other way.
			const can = t.viewerCanResolve !== false || t.viewerCanUnresolve !== false;
			if (can) {
				t.viewerCanResolve = !resolve;
				t.viewerCanUnresolve = resolve;
			}
			save();
			if (failing) failAs(failing, mutation);
			print({ data: { [mutation]: { thread: { id: f.id, isResolved: resolve } } } });
		}
		// One thread's summary by id, and its PR (a write's re-read).
		if (/node\(id: \$id\) \{\s*\.\.\. on PullRequestReviewThread \{/.test(f.query)) {
			const place = threadPlace(f.id);
			if (!place) {
				process.stdout.write(
					`${JSON.stringify({ data: { node: null }, errors: [{ type: "NOT_FOUND", path: ["node"], message: `Could not resolve to a node with the global id of '${f.id}'` }] })}\n`,
				);
				fail(`gh: Could not resolve to a node with the global id of '${f.id}'`);
			}
			print({
				data: {
					node: {
						...summarize(place.node),
						pullRequest: {
							number: Number(place.n),
							repository: { nameWithOwner: s.nameWithOwner ?? "acme/widget" },
						},
					},
				},
			});
		}
		// The rest of one review's comments (--head reviewed): node(id) {
		// ... on PullRequestReview { comments(first: 100, after: $endCursor) } },
		// from reviewComments (the whole list; the review node holds page 1).
		if (/node\(id: \$id\) \{\s*\.\.\. on PullRequestReview \{/.test(f.query)) {
			const all = s.reviewComments?.[f.id];
			if (!all) {
				print({
					data: { node: null },
					errors: [{ type: "NOT_FOUND", path: ["node"] }],
				});
			}
			const size = s.pageSize ?? 100;
			const start = f.endCursor ? Number(f.endCursor.replace("cursor:", "")) : 0;
			const end = start + size;
			const hasNextPage = end < all.length;
			print({
				data: {
					node: {
						comments: {
							pageInfo: {
								hasNextPage,
								endCursor: hasNextPage ? `cursor:${end}` : null,
							},
							nodes: all.slice(start, end),
						},
					},
				},
			});
		}
		// The rest of threads' comments, a page each by alias:
		// t<i>: node(id: "…") { … comments(first: 100, after: "cursor:<n>") }.
		const aliased = [
			...f.query.matchAll(
				/(t\d+): node\(id: "([^"]*)"\) \{ \.\.\. on PullRequestReviewThread \{ comments\(first: 100(?:, after: "([^"]*)")?\)/g,
			),
		];
		if (aliased.length) {
			delay("comments", s.commentsDelayMs);
			const text = f.query.includes("bodyHTML");
			const data = {};
			const errors = [];
			for (const [, alias, id, after] of aliased) {
				const node = threadById(id);
				if (!node) {
					data[alias] = null;
					errors.push({
						type: "NOT_FOUND",
						path: [alias],
						message: `Could not resolve to a node with the global id of '${id}'`,
					});
					continue;
				}
				const all = commentTexts(node).map((c) => (text ? c : summaryOf(c)));
				const start = after ? Number(after.replace("cursor:", "")) : 0;
				data[alias] = { comments: commentPage(all, start) };
			}
			if (errors.length) {
				process.stdout.write(`${JSON.stringify({ data, errors })}\n`);
				fail(`gh: ${errors[0].message}`);
			}
			print({ data });
		}
		// Threads' comments by node id (any PR's threads), their text
		// included: the first page of each (commentPageSize).
		const byIds = /nodes\(ids: \[([^\]]*)\]\)/.exec(f.query);
		if (byIds) {
			delay("threadContent", s.threadContentDelayMs);
			delay("comments", s.commentsDelayMs);
			const ids = [...byIds[1].matchAll(/"([^"]*)"/g)].map((m) => m[1]);
			const nodes = ids.map((id) => {
				const node = threadById(id);
				if (!node) return null;
				const all = commentTexts(node);
				return {
					id,
					comments: {
						totalCount: node.comments?.totalCount ?? all.length,
						...commentPage(all, 0),
					},
				};
			});
			const missing = ids.flatMap((id, i) => (nodes[i] ? [] : [[id, i]]));
			if (missing.length) {
				// Like GitHub: the data, an error per missing node, and gh exits 1.
				process.stdout.write(
					`${JSON.stringify({
						data: { nodes },
						errors: missing.map(([id, i]) => ({
							type: "NOT_FOUND",
							path: ["nodes", i],
							locations: [{ line: 1, column: 9 }],
							message: `Could not resolve to a node with the global id of '${id}'`,
						})),
					})}\n`,
				);
				fail(
					`gh: Could not resolve to a node with the global id of '${missing[0][0]}'`,
				);
			}
			print({ data: { nodes } });
		}
		// The timeline, a page by position (`skip`).
		if (/timelineItems\(first: \d+, skip: \$skip/.test(f.query)) {
			if (!pr0()) notFound(f.number);
			delay("timeline", s.timelineDelayMs);
			const all = pr0().graphql?.timelineItems ?? [];
			const size = Number(/timelineItems\(first: (\d+)/.exec(f.query)[1]);
			const skip = Number(f.skip ?? 0);
			// A test can make the list change between the pages' reads.
			// Counted but not listed (GitHub's caps, items the token can't see).
			const counted = all.length + (s.timelineUnlisted ?? 0);
			const count = s.timelineCountDrift ? counted + skip : counted;
			print({
				data: {
					repository: {
						pullRequest: {
							commits: {
								totalCount:
									pr0().graphql?.commitCount ??
									all.filter((n) => n.__typename === "PullRequestCommit").length,
							},
							timelineItems: {
								filteredCount: count,
								nodes: all.slice(skip, skip + size),
							},
						},
					},
				},
			});
		}
		const conn = /(\w+)\((?:first: \d+, after: \$endCursor|last: \d+)\)/.exec(
			f.query,
		)?.[1];
		// A connection's last page (`last: N`), not one after a cursor.
		const fromEnd = f.query.includes(`${conn}(last: `);
		const pr = s.prs[f.number];
		// The description query: pullRequest { bodyHTML }, no connection.
		if (!conn && /pullRequest\(number: \$number\) \{ bodyHTML \}/.test(f.query)) {
			if (!pr) notFound(f.number);
			print({
				data: {
					repository: { pullRequest: { bodyHTML: pr.graphql?.bodyHTML ?? "" } },
				},
			});
		}
		// One commit's checks: object(oid) { ... statusCheckRollup { contexts } }.
		if (conn === "contexts") {
			const commit = s.commits?.[f.oid];
			if (commit === undefined) {
				print({ data: { repository: { object: null } } });
			}
			if (commit.contexts === null) {
				print({ data: { repository: { object: { statusCheckRollup: null } } } });
			}
			const all = commit.contexts ?? [];
			const size = s.pageSize ?? 100;
			const start = f.endCursor ? Number(f.endCursor.replace("cursor:", "")) : 0;
			const end = start + size;
			const hasNextPage = end < all.length;
			print({
				data: {
					repository: {
						object: {
							statusCheckRollup: {
								contexts: {
									pageInfo: {
										hasNextPage,
										endCursor: hasNextPage ? `cursor:${end}` : null,
									},
									nodes: all.slice(start, end),
								},
							},
						},
					},
				},
			});
		}
		if (!["reviewThreads", "comments", "reviews", "commits"].includes(conn)) {
			unsupported();
		}
		if (!pr) notFound(f.number);
		let all = pr.graphql?.[conn] ?? [];
		if (conn === "reviewThreads") {
			delay("threads", s.threadsDelayMs);
			const raw = all;
			all = threadNodes(f.number, raw).filter((_, k) => !allRemoved(raw[k]) && !hiddenThread(raw[k]));
			// Only the fields asked for: a summary has no comment text, and
			// lists a thread's first page of comments (commentPageSize).
			if (!f.query.includes("bodyHTML")) all = all.map(summarize);
		}
		const size = s.pageSize ?? 100;
		const start = fromEnd
			? Math.max(0, all.length - size)
			: f.endCursor
				? Number(f.endCursor.replace("cursor:", ""))
				: 0;
		const end = start + size;
		const hasNextPage = !fromEnd && end < all.length;
		print({
			data: {
				repository: {
					pullRequest: {
						[conn]: {
							totalCount: all.length,
							pageInfo: {
								hasNextPage,
								endCursor: hasNextPage ? `cursor:${end}` : null,
							},
							nodes: all.slice(start, end),
						},
					},
				},
			},
		});
		break;
	}
}
