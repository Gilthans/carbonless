{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"lib": ["ES2024"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"types": ["node"],
		"noEmit": false,
		"rootDir": "src",
		"outDir": "dist",
		"sourceMap": true
	},
	"include": ["src/cli.ts", "src/server", "src/shared"],
	"exclude": ["**/*.test.ts"]
}
