{
	"name": "carbonless",
	"version": "0.0.0",
	"private": true,
	"description": "Local, AI-assisted tool for reading the changes between two git commits",
	"type": "module",
	"bin": {
		"crb": "dist/cli.js"
	},
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "concurrently -k -n api,web -c blue,magenta \"tsx watch src/cli.ts $CRB_PR --port 4747 --no-open --api-only\" \"vite\"",
		"build": "rm -rf dist && tsc -p tsconfig.build.json && vite build",
		"start": "node dist/cli.js",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome check .",
		"fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "pnpm build && playwright test",
		"verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e"
	},
	"dependencies": {
		"@fastify/cookie": "^11.1.3",
		"@fastify/static": "^10.1.6",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-router": "1.170.40",
		"fastify": "^5.12.7",
		"open": "^11.0.4",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"shiki": "^4.5.0",
		"ulid": "^3.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.64.1",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"concurrently": "^10.0.6",
		"jsdom": "^30.1.3",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	}
}
