{
	"name": "carbonless-review",
	"version": "0.1.0-rc.4",
	"description": "Local, AI-assisted tool for reading the changes between two git commits",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Gilthans/carbonless.git"
	},
	"type": "module",
	"bin": {
		"crb": "dist/cli.js"
	},
	"files": [
		"dist",
		"!dist/**/*.map"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "node scripts/dev.mjs",
		"build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-info.mjs && vite build",
		"start": "node dist/cli.js",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "biome check .",
		"fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:changed": "vitest run --changed",
		"test:e2e": "pnpm build && node scripts/queue.mjs --unless-filtered playwright test",
		"test:pack": "node scripts/pack-smoke.mjs",
		"verify": "pnpm lint && pnpm typecheck && node scripts/queue.mjs sh -c 'pnpm test && pnpm test:e2e && pnpm test:pack'",
		"verify:fast": "node scripts/verify-fast.mjs",
		"flake-check": "node scripts/flake-check.mjs",
		"icons": "tsx scripts/render-icons.ts",
		"compare-threads": "tsx scripts/compare-threads.ts",
		"test-profile": "tsx scripts/test-profile/main.ts",
		"release": "tsx scripts/release.ts",
		"prepack": "pnpm build"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "2.4.0",
		"@fastify/cookie": "^11.1.3",
		"@fastify/static": "^10.1.6",
		"fastify": "^5.12.7",
		"open": "^11.0.4",
		"ulid": "^3.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
		"@fontsource-variable/outfit": "5.3.0",
		"@playwright/test": "^1.64.1",
		"@primer/octicons-react": "19.40.0",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-router": "1.170.40",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/diff-match-patch": "^1.0.36",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"diff-match-patch": "^1.0.5",
		"dompurify": "3.4.16",
		"github-markdown-css": "5.9.0",
		"jsdom": "^30.1.3",
		"marked": "18.1.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"shiki": "^4.5.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	}
}
