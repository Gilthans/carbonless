# The always-on crb serve, a systemd user service. Written by
# scripts/devbox/install from scripts/devbox/crb.service.template: edit the
# template and rerun install, not this file.
#
# XDG_CONFIG_HOME is deliberately not set: gh keeps its login under it, and
# the service must see the same login and config.json as your shell.
# Logs: journalctl --user -u crb
[Unit]
Description=carbonless review server (crb serve)
# Keep retrying (e.g. the serve host's network, such as Tailscale, comes up late).
StartLimitIntervalSec=0

[Service]
Type=simple
Environment="PATH=@PATH@"
ExecStart="@CRB@" serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
