#!/usr/bin/env bash
# Moves the always-on crb serve to another build:
#   scripts/devbox/update <tarball | rc | latest | version>
# A tarball path (from pnpm pack) installs that file; rc, latest or a version
# install carbonless-review@<spec> from npm. Installs with pnpm add -g on
# Node 24, rewrites crb.service if Node 24 or crb moved, restarts it, waits
# until it serves the new build and prints its link. Run
# scripts/devbox/install once first.
# Overrides for tests and odd setups: see lib.sh.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$here/lib.sh"

[[ $# -eq 1 ]] || die "usage: scripts/devbox/update <tarball | rc | latest | version>"
spec="$(package_spec "$1")"
[[ -f "$UNIT_FILE" ]] || die "$UNIT_FILE not found: run scripts/devbox/install first"
# Never alongside crb-follow (or another update).
take_lock wait

from="$(installed_build)"
run pnpm add -g "$spec"
to="$(installed_build)"
[[ -n "$to" ]] || die "$PACKAGE is not installed after pnpm add -g $spec"

write_unit "$(global_crb)"
run systemctl --user restart "$UNIT"
wait_for_build "$to"
echo "crb: $(pretty_build "$from") -> $(pretty_build "$to")"
service_url
