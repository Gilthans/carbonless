#!/usr/bin/env bash
# Sets up the always-on crb serve as a systemd user service (crb.service):
#   scripts/devbox/install [--no-follow] [<tarball | rc | latest | version>]
# With a spec, installs that package first (see update); without one, the
# globally installed crb must already be there. Checks Node 24, gh's login
# and linger, writes ~/.config/systemd/user/crb.service, enables and
# (re)starts it, waits until it answers and prints its link. Then, unless
# --no-follow, copies these scripts to ~/.local/share/carbonless/devbox and
# writes and enables crb-follow.service (running that copy's follow) and
# crb-follow.timer, which move it to the newest master / rc build every 5
# minutes (scripts/devbox/follow). Safe to rerun.
# Overrides for tests and odd setups: see lib.sh.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib.sh
source "$here/lib.sh"

spec="" follow=1
for arg in "$@"; do
	case "$arg" in
	--no-follow) follow="" ;;
	-*) die "usage: scripts/devbox/install [--no-follow] [<tarball | rc | latest | version>]" ;;
	*)
		[[ -z "$spec" ]] || die "usage: scripts/devbox/install [--no-follow] [<tarball | rc | latest | version>]"
		spec="$(package_spec "$arg")"
		;;
	esac
done
echo "Node: $NODE_BIN"
# Never alongside crb-follow or update.
take_lock wait

# The service sees gh's login under ~/.config/gh, not a token or another
# config dir set in this shell.
env -u GH_TOKEN -u GITHUB_TOKEN -u GH_CONFIG_DIR -u XDG_CONFIG_HOME gh auth status >/dev/null 2>&1 ||
	die "gh is not logged in: run gh auth login, then rerun this"

if [[ "$(loginctl show-user "$(id -un)" --property=Linger --value 2>/dev/null || true)" != yes ]]; then
	echo "warning: linger is off, so crb stops when you log out and won't start at boot. Turn it on with:" >&2
	echo "  sudo loginctl enable-linger $(id -un)" >&2
fi

if [[ -n "$spec" ]]; then
	run pnpm add -g "$spec"
fi
crb="$(global_crb)"
[[ -x "$crb" || -n "$DRY_RUN" ]] ||
	die "$crb not found: pass a tarball or version to install it (scripts/devbox/install <spec>)"

# crb-follow's units; the daemon-reload below picks up any change.
if [[ -n "$follow" ]]; then
	path="$(unit_path)"
	repo="$(follow_repo)"
	# A copy of these scripts that follow keeps current from master's.
	install_scripts "$DEVBOX_DIR"
	render_unit crb-follow.service.template "$UNIT_DIR/crb-follow.service" \
		"PATH=$path" "PNPM_HOME=$PNPM_HOME" "REPO=$repo" "FOLLOW=$SCRIPTS_HOME/follow" || true
	render_unit crb-follow.timer "$UNIT_DIR/crb-follow.timer" || true
fi
write_unit "$crb"
[[ -n "$UNIT_CHANGED" ]] || run systemctl --user daemon-reload
run systemctl --user enable "$UNIT"
build="$(installed_build)"
if [[ -z "$build" && -z "$DRY_RUN" ]]; then
	die "can't read the installed $PACKAGE's build (dist/build-info.json via pnpm ls -g)"
fi
if [[ -n "$UNIT_CHANGED" || -n "$spec" ]] || ! { serves_build "$build" && service_serves; }; then
	run systemctl --user restart "$UNIT"
fi
[[ -z "$build" ]] || wait_for_build "$build"
echo "crb $(pretty_build "$build") is serving: $(service_url)"
if [[ -n "$follow" ]]; then
	run systemctl --user enable --now crb-follow.timer
	echo "crb follows rc / origin/master every 5 minutes: journalctl --user -u crb-follow"
fi
