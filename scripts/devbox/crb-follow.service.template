# Moves crb.service to the newest build, run by crb-follow.timer. It runs
# install's copy of scripts/devbox (~/.local/share/carbonless/devbox), which
# follow refreshes from each master build, not a checkout's scripts. Written by scripts/devbox/install from
# scripts/devbox/crb-follow.service.template: edit the template and rerun
# install, not this file.
#
# XDG_CONFIG_HOME is deliberately not set, as for crb.service: git fetches
# with gh's login, and follow reads the same config.json as your shell.
# Logs: journalctl --user -u crb-follow
[Unit]
Description=carbonless: move crb serve to the newest master / rc build

[Service]
Type=oneshot
# A hung fetch or pnpm install must not hold off every later tick.
TimeoutStartSec=30min
# Nothing may wait for input: a git credential prompt fails instead.
Environment="GIT_TERMINAL_PROMPT=0"
Environment="PATH=@PATH@"
Environment="PNPM_HOME=@PNPM_HOME@"
Environment="CRB_DEVBOX_REPO=@REPO@"
ExecStart="@FOLLOW@"
