// CAR-260: no fixed sleeps in tests (`await new Promise((r) =>
// setTimeout(r, 50))`, `node:timers/promises`): on a loaded machine the
// thing waited for comes later, and "nothing happened in 50 ms" proves
// little. Hold the answer (the fake gh's `hold`, a held fetch), wait on the
// state (`waitFor`, `expect.poll`), or move a fake clock past the window.
//
// Allowed: a timer of 0 (or none), which yields one macrotask rather than
// waiting for time, and a sleep in a `while`, `do … while` or `for (;;)`
// loop, which polls a condition. A counted loop (`for (…; …; i++)`,
// `for … of`) is a longer fixed sleep and is flagged. So is a
// `Promise.race` against a timer, on purpose: "X doesn't wait for Y" is X
// resolving while Y is held, not a time bound.
//
// A sleep that is the point goes through test/sleep.ts: `quietFor(ms, why)`
// (a window for something that must not happen) or `fakeDelay(ms)` (a
// fake's latency). quietFor itself is flagged in a before/after hook (a
// drain there races the next test: stop or flush what runs instead) and
// over 500 ms (an app timer's window: move a fake clock), unless a
// `biome-ignore lint/plugin/no-sleep-in-tests: <why>` says why not.
//
// Scoped in biome.json to test files and the files directly in e2e/ and
// test/ (so not the fakes in test/fake-gh/, test/fake-acp/). CLAUDE.md,
// "Development" (test rules); docs/ci-flakes.md, "Lint rules".
language js

or {
	JsNewExpression(callee=$callee, arguments=$args) as $sleep where {
		$callee <: `Promise`,
		$args <: contains or {
			`setTimeout($_, $ms)`,
			`$_.setTimeout($_, $ms)`
		},
		not $ms <: `0`,
		not $sleep <: within or {
			JsWhileStatement(),
			JsDoWhileStatement(),
			JsForStatement(update=$update) where { $update <: . }
		},
		register_diagnostic(span=$sleep, message="no-sleep-in-tests: hold the answer, wait on the state (waitFor, expect.poll) or move a fake clock; for an absence or a fake's latency, test/sleep.ts. CLAUDE.md test rules.")
	},
	JsImport() as $import where {
		$import <: contains r"^[\"'](?:node:)?timers/promises[\"']$",
		register_diagnostic(span=$import, message="no-sleep-in-tests: no timers/promises sleeps in tests; hold, wait on the state or move a fake clock. CLAUDE.md test rules.")
	},
	`quietFor($ms, $_)` as $quiet where {
		$quiet <: within or {
			`beforeEach($_)`,
			`afterEach($_)`,
			`beforeAll($_)`,
			`afterAll($_)`
		},
		register_diagnostic(span=$quiet, message="no-sleep-in-tests: no quietFor in a hook; stop or flush what is running instead. CLAUDE.md test rules.")
	},
	`quietFor($ms, $_)` as $quiet where {
		$ms <: r"^(?:50[1-9]|5[1-9][0-9]|[6-9][0-9][0-9]|[1-9][0-9_]{3,})$",
		register_diagnostic(span=$quiet, message="no-sleep-in-tests: a quietFor over 500 ms waits out an app timer; move a fake clock. CLAUDE.md test rules.")
	}
}
